{
  "info": {
    "name": "PetSalud - Pruebas de Seguridad",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tokenGerente",
      "value": ""
    },
    {
      "key": "tokenEmpleado",
      "value": ""
    },
    {
      "key": "tokenCliente",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Login (ejecutar primero)",
      "item": [
        {
          "name": "Login GERENTE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"gerente@petsalud.cl\", \"password\": \"Petsalud2024\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', ()=>pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenGerente', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login EMPLEADO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"empleado@petsalud.cl\", \"password\": \"Petsalud2024\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', ()=>pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenEmpleado', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login CLIENTE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"cliente@petsalud.cl\", \"password\": \"Petsalud2024\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', ()=>pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenCliente', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login contraseña incorrecta -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"cliente@petsalud.cl\", \"password\": \"incorrecta1\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', ()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registro cliente (intenta rol GERENTE) -> 201 CLIENTE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"nuevo.cliente@correo.cl\", \"password\": \"Segura123\", \"nombre\": \"Nuevo\", \"rol\": \"GERENTE\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', ()=>pm.response.to.have.status(201));",
                  "pm.test('Rol forzado a CLIENTE', ()=>pm.expect(pm.response.json().rol).to.eql('CLIENTE'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
