    {
      "name": "3. Amenazas",
      "item": [
        {
          "name": "SQLi en login -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"' OR '1'='1' -- \", \"password\": \"' OR '1'='1\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', ()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "SQLi en búsqueda -> 200 lista vacía",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              }
            ],
            "url": "{{baseUrl}}/api/productos/categoria?categoria=Accesorios'%20OR%20'1'='1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', ()=>pm.response.to.have.status(200));",
                  "pm.test('No devuelve datos', ()=>pm.expect(pm.response.json().length).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "XSS en registro -> nombre escapado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"xss.demo@correo.cl\", \"password\": \"Segura123\", \"nombre\": \"<script>alert('xss')</script>\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', ()=>pm.response.to.have.status(201));",
                  "pm.test('Sin <script>', ()=>pm.expect(pm.response.json().nombre).to.not.include('<script>'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Token alterado -> 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJnZXJlbnRlQHBldHNhbHVkLmNsIiwicm9sIjoiR0VSRU5URSJ9.firmaFalsa"
              }
            ],
            "url": "{{baseUrl}}/api/productos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', ()=>pm.response.to.have.status(401));"
